# Скопируйте в .env и заполните (или передайте аргументами CLI):
# python cli.py --api-key ... --base-url http://localhost:8000/v1 --model gpt-4o-mini

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Ограничение провайдера маршрутизации (например OpenRouter): JSON-массив,
# передаётся в тело запроса как provider.only. Пусто — не передаётся.
# LLM_PROVIDER_ONLY=["DeepSeek","deepseek/fp8"]
